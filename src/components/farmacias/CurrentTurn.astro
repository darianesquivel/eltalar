---
import { ARGENTINA_TZ } from "../../lib/hours";
import { getCurrentTurns } from "../../lib/repositories/pharmacy.repository";
import PharmacyCard from "./PharmacyCard.astro";

const formatUntil = (endsAt: string) =>
  new Date(endsAt).toLocaleString("es-AR", {
    weekday: "long",
    hour: "2-digit",
    minute: "2-digit",
    timeZone: ARGENTINA_TZ,
  });

// La consulta vive en el repositorio: la home muestra la misma farmacia
const pharmacies = await getCurrentTurns(Astro.locals.barrio.id);
const hasTurns = pharmacies.length > 0;
---

<section>
  <div class="mb-6 flex items-center justify-between">
    <h2 id="farmacias-de-turno" class="text-2xl font-bold">De turno</h2>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    {
      hasTurns ? (
        pharmacies.map((turn) => (
          <PharmacyCard
            name={turn.name}
            address={turn.address ?? undefined}
            badge="🟢 De turno ahora"
            subtitle={`Hasta el ${formatUntil(turn.ends_at)} hs`}
            phone={turn.phone}
            whatsapp={turn.whatsapp}
            highlight
          />
        ))
      ) : (
        <div class="rounded-2xl bg-gray-50 p-6 text-center text-gray-500">
          No hay farmacias de turno en este momento.
        </div>
      )
    }
  </div>
</section>
