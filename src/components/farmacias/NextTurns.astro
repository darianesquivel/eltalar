---
import { ChevronRight } from "@lucide/astro";
import { ARGENTINA_TZ } from "../../lib/hours";
import type { PharmacyTurn } from "../../lib/repositories/pharmacy.repository";

interface Props {
  turns: PharmacyTurn[];
}

const { turns } = Astro.props;

const datePart = (iso: string, opts: Intl.DateTimeFormatOptions) =>
  new Date(iso).toLocaleDateString("es-AR", {
    timeZone: ARGENTINA_TZ,
    ...opts,
  });
---

<section id="farmacias-proximos-turnos">
  <div class="mb-4 flex items-baseline justify-between gap-4">
    <h2
      class="text-[19px] font-extrabold tracking-[-0.015em] text-text-main sm:text-[26px]"
    >
      Próximos turnos
    </h2>
  </div>

  {
    turns.length > 0 ? (
      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {turns.map((turn) => (
          <a
            href={`/negocios/${turn.slug}`}
            class="flex items-center gap-4 rounded-[18px] bg-bg-card p-4 shadow-soft transition-colors hover:bg-white sm:p-5"
          >
            <div class="flex size-14 shrink-0 flex-col items-center justify-center rounded-2xl bg-primary-faint leading-[1.1]">
              <span class="text-[19px] font-extrabold text-text-main">
                {datePart(turn.starts_at, { day: "numeric" })}
              </span>
              <span class="text-[9.5px] font-bold uppercase tracking-[0.06em] text-text-body">
                {datePart(turn.starts_at, { weekday: "short" }).replace(".", "")}
              </span>
            </div>
            <div class="flex-1">
              <div class="text-[15.5px] font-bold leading-tight text-text-main sm:text-[16.5px]">
                {turn.name}
              </div>
              {turn.address && (
                <div class="mt-[3px] text-[13px] text-text-muted">
                  {turn.address}
                </div>
              )}
            </div>
            <ChevronRight
              class="size-[18px] shrink-0 text-text-faint"
              aria-hidden="true"
            />
          </a>
        ))}
      </div>
    ) : (
      <p class="rounded-[18px] bg-bg-card p-5 text-[14px] text-text-muted shadow-soft">
        No hay turnos próximos cargados.
      </p>
    )
  }
</section>
