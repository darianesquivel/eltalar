---
import Logo from "../../assets/logo.svg";
import { DEFAULT_BARRIO } from "../../lib/barrio";

const barrio = Astro.locals.barrio ?? DEFAULT_BARRIO;

const LINKS = [
  { href: "/negocios", label: "Negocios" },
  { href: "/ofertas", label: "Ofertas" },
  { href: "/farmacias", label: "Farmacias" },
  { href: "/eventos", label: "Eventos" },
  { href: "/avisos", label: "Avisos de vecinos" },
  { href: "/telefonos", label: "Teléfonos útiles" },
  { href: "/mapa", label: "Mapa" },
  { href: "/anunciate", label: "Anunciate" },
  { href: "/contacto", label: "Contacto" },
];
---

<footer class="bg-secondary text-white">
  <div
    class="mx-auto flex max-w-[1280px] flex-col gap-8 px-[18px] py-10 sm:px-10 md:flex-row md:items-start md:justify-between"
  >
    <div class="flex items-start gap-4">
      <img
        src={Logo.src}
        alt=""
        class="w-[70px] brightness-0 invert"
      />
      <div>
        <div class="text-[17px] font-bold">
          {barrio.name} · La guía del barrio
        </div>
        <div class="mt-1.5 text-[13px] leading-relaxed text-white/60">
          Hecho por vecinos, para vecinos.<br />
          {barrio.partido}, Buenos Aires.
        </div>
      </div>
    </div>

    <nav
      class="grid grid-cols-2 gap-x-10 gap-y-2.5 text-[13.5px] text-white/75 sm:grid-cols-3"
    >
      {
        LINKS.map((link) => (
          <a href={link.href} class="transition-colors hover:text-white">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div
    class="mx-auto max-w-[1280px] px-[18px] pb-[92px] text-[12px] text-white/50 sm:px-10 md:pb-10"
  >
    © {new Date().getFullYear()} {barrio.name}
  </div>
</footer>
