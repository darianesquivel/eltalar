---
import * as icons from "@lucide/astro";
import { TAB_ITEMS } from "../../lib/nav";

// Barra inferior fija: es la navegación principal en mobile. Lo que está
// acá NO se repite en el menú hamburguesa (ver src/lib/nav.ts).
const ITEMS = TAB_ITEMS;

const iconFor = (name: string) =>
  (icons as Record<string, any>)[name] ?? icons.House;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<nav
  aria-label="Navegación principal"
  class="fixed inset-x-0 bottom-0 z-50 flex justify-around border-t border-border bg-bg-card px-2 pt-2.5 pb-3.5 shadow-tab md:hidden"
>
  {
    ITEMS.map((item) => {
      const active = isActive(item.href);
      const Icon = iconFor(item.icon);
      return (
        <a
          href={item.href}
          aria-current={active ? "page" : undefined}
          class:list={[
            "flex flex-col items-center gap-1",
            active ? "text-primary" : "text-text-muted",
          ]}
        >
          <Icon class="size-[22px]" aria-hidden="true" />
          <span
            class:list={[
              "text-[10.5px]",
              active ? "font-bold" : "font-semibold",
            ]}
          >
            {item.label}
          </span>
        </a>
      );
    })
  }
</nav>
