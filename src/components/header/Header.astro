---
import { Search, Menu, X } from "@lucide/astro";
import Logo from "../../assets/logo.svg";
import UserMenu from "./UserMenu.client";
import { MOBILE_MENU_ITEMS, NAV_ITEMS } from "../../lib/nav";

const path = Astro.url.pathname;

// El buscador global es el cambio funcional más importante del rediseño:
// vive en el header de todas las páginas y entra por GET a la guía.
const query = path.startsWith("/negocios")
  ? (Astro.url.searchParams.get("buscar") ?? "")
  : "";

const POPULARES = ["farmacia", "delivery", "plomero", "veterinaria"];

const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

// El logo va plano en tinta, igual que el del footer (que se ve como
// silueta al invertirse a blanco). Se pinta con máscara y no con
// filter:brightness(0) para dar el color del sistema y no negro puro.
const logoMask = `aspect-ratio:526/410;-webkit-mask:url(${Logo.src}) center/contain no-repeat;mask:url(${Logo.src}) center/contain no-repeat`;
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg-card"
  data-header
>
  <!-- Desktop -->
  <div
    class="mx-auto hidden max-w-[1280px] items-center gap-[22px] px-10 py-[14px] md:flex"
  >
    <a href="/" class="shrink-0">
      <span
        role="img"
        aria-label="El Talar"
        class="block w-[72px] bg-secondary"
        style={logoMask}
      />
    </a>

    <form
      action="/negocios"
      method="get"
      role="search"
      class="flex max-w-[460px] flex-1 items-center rounded-[14px] bg-bg-muted px-4 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary"
    >
      <Search class="size-[18px] shrink-0 text-primary" aria-hidden="true" />
      <input
        type="search"
        name="buscar"
        value={query}
        autocomplete="off"
        aria-label="Buscar en el barrio"
        placeholder="Buscá comercio, rubro o servicio"
        class="w-full bg-transparent px-3 py-[13px] text-[15px] text-text-main outline-none placeholder:text-text-muted"
      />
    </form>

    <nav class="ml-auto flex items-center gap-0.5">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "rounded-full text-sm transition-colors",
              isActive(item.href)
                ? "bg-primary-faint px-3.5 py-2 font-semibold text-text-main"
                : "px-3 py-2 font-medium text-text-body hover:text-text-main",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/app/login"
        data-solo-sin-sesion
        class="text-sm font-medium text-text-body transition-colors hover:text-text-main"
      >
        Ingresar
      </a>
      <UserMenu client:idle />
    </div>
  </div>

  <!-- Mobile -->
  <div class="md:hidden">
    <div class="flex items-center justify-between px-[18px] py-3">
      <a href="/">
        <span
          role="img"
          aria-label="El Talar"
          class="block w-[62px] bg-secondary"
          style={logoMask}
        />
      </a>
      <div class="flex items-center gap-2">
      <UserMenu client:idle />
      <button
        id="menu-button"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex size-9 items-center justify-center rounded-full bg-primary-faint text-text-main"
      >
        <Menu class="size-[17px]" data-menu-icon="open" aria-hidden="true" />
        <X class="hidden size-[17px]" data-menu-icon="close" aria-hidden="true" />
      </button>
      </div>
    </div>

    <div class="px-[18px] pb-4">
      <form
        action="/negocios"
        method="get"
        role="search"
        class="flex items-center rounded-[14px] bg-bg-muted px-3.5 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary"
      >
        <Search class="size-[19px] shrink-0 text-primary" aria-hidden="true" />
        <input
          type="search"
          name="buscar"
          value={query}
          autocomplete="off"
          aria-label="Buscar en el barrio"
          placeholder="¿Qué buscás en el barrio?"
          class="w-full bg-transparent px-3 py-[15px] text-[15.5px] text-text-main outline-none placeholder:text-text-muted"
        />
      </form>

      <div class="mt-3 flex gap-[7px] overflow-x-auto [scrollbar-width:none]">
        {
          POPULARES.map((term) => (
            <a
              href={`/negocios?buscar=${encodeURIComponent(term)}`}
              class="shrink-0 rounded-full border border-border bg-bg-main px-[13px] py-[7px] text-[12.5px] font-medium text-text-main"
            >
              {term}
            </a>
          ))
        }
      </div>
    </div>

    <nav
      id="mobile-menu"
      hidden
      class="border-t border-border px-[18px] py-4"
      aria-label="Secciones"
    >
      <div class="flex flex-col gap-1">
        {
          MOBILE_MENU_ITEMS.map((item) => (
            <a
              href={item.href}
              class:list={[
                "rounded-xl px-3 py-2.5 text-[15px]",
                isActive(item.href)
                  ? "bg-primary-faint font-semibold text-text-main"
                  : "font-medium text-text-body",
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="/app/login"
          data-solo-sin-sesion
          class="rounded-xl px-3 py-2.5 text-[15px] font-medium text-text-body"
        >
          Ingresar
        </a>
      </div>
    </nav>
  </div>

  <script>
    const setupMobileMenu = () => {
      const button = document.getElementById("menu-button");
      const menu = document.getElementById("mobile-menu");

      if (!button || !menu) return;

      button.onclick = () => {
        const open = menu.hasAttribute("hidden");

        menu.toggleAttribute("hidden", !open);
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");

        button
          .querySelector("[data-menu-icon='open']")
          ?.classList.toggle("hidden", open);
        button
          .querySelector("[data-menu-icon='close']")
          ?.classList.toggle("hidden", !open);
      };
    };

    // Con sesión iniciada, "Ingresar" desaparece: lo del usuario vive en el
    // menú del avatar. Se detecta por la cookie de Supabase
    // (sb-...-auth-token), sin pegarle a la base: las páginas públicas las
    // cachea el CDN y no pueden depender de la sesión en el servidor.
    const updateBusinessCta = () => {
      if (!document.cookie.includes("-auth-token")) return;

      document.querySelectorAll("[data-solo-sin-sesion]").forEach((el) => {
        el.setAttribute("hidden", "");
      });
    };

    setupMobileMenu();
    updateBusinessCta();

    document.addEventListener("astro:page-load", () => {
      setupMobileMenu();
      updateBusinessCta();
    });
  </script>
</header>
