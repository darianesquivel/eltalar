---
import { Share2 } from "@lucide/astro";

interface Props {
  url: string;
  title: string;
  /** Clases del botón, para que cada pantalla lo ubique donde quiera. */
  class?: string;
}

const { url, title, class: className = "" } = Astro.props;
---

<div class="contents" data-share data-url={url} data-title={title}>
  <button type="button" data-share-btn class={className}>
    <Share2 class="size-4" aria-hidden="true" />
    Compartir
  </button>
  <span
    data-share-feedback
    class="pointer-events-none fixed inset-x-0 bottom-24 z-50 mx-auto w-fit rounded-full bg-secondary px-4 py-2 text-[13px] font-semibold text-white opacity-0 transition-opacity"
    role="status"
  >
    Link copiado
  </span>
</div>

<script is:inline data-astro-rerun>
  // IIFE + datos por data-attributes: al re-ejecutarse tras cada navegación
  // (data-astro-rerun), los const globales chocarían.
  (() => {
    const box = document.querySelector("[data-share]");
    if (!box) return;

    const button = box.querySelector("[data-share-btn]");
    const feedback = box.querySelector("[data-share-feedback]");
    const url = box.dataset.url;
    const title = box.dataset.title;

    button?.addEventListener("click", async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
          return;
        } catch {
          // el usuario canceló: no hace falta avisar nada
          return;
        }
      }

      await navigator.clipboard.writeText(url);
      feedback?.classList.remove("opacity-0");
      setTimeout(() => feedback?.classList.add("opacity-0"), 2000);
    });
  })();
</script>
