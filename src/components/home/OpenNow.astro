---
import { ArrowRight } from "@lucide/astro";
import OpenNowCards from "./OpenNowCards";
import type { BusinessSummary } from "../../lib/repositories/business.repository";

interface Props {
  businesses: BusinessSummary[];
}

const { businesses } = Astro.props;
---

{
  businesses.length > 0 && (
    <section class="pb-11">
      <div class="mb-[18px] flex items-baseline justify-between gap-4">
        <div>
          <h2 class="text-[19px] font-extrabold tracking-[-0.015em] text-text-main sm:text-[26px]">
            Abiertos ahora
          </h2>
          <p class="mt-1 text-[13px] text-text-muted sm:text-sm">
            Comercios del barrio con las puertas abiertas en este momento.
          </p>
        </div>
        <a
          href="/negocios?abierto=1"
          class="inline-flex shrink-0 items-center gap-1.5 text-[13px] font-semibold text-primary-strong sm:text-sm"
        >
          Ver todos
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="grid gap-[18px] sm:grid-cols-2 lg:grid-cols-4">
        <OpenNowCards businesses={businesses} client:visible />
      </div>
    </section>
  )
}
