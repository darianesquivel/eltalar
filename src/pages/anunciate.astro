---
import {
  ArrowRight,
  BadgeCheck,
  Check,
  HeartHandshake,
  Star,
  Store,
  TrendingUp,
} from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";

const { barrio } = Astro.locals;
const price = Number(import.meta.env.MP_FEATURED_PRICE ?? 6500);

// Últimos 30 días, para las métricas de tracking
const since = new Date(Date.now() - 30 * 86_400_000).toISOString();

const countEvents = (event: string) =>
  supabase
    .from("business_events")
    .select("id, businesses!inner(barrio_id)", { count: "exact", head: true })
    .eq("businesses.barrio_id", barrio.id)
    .eq("event", event)
    .gte("created_at", since);

// Números reales: comercios cargados y actividad del último mes. Nada
// estimado — si una métrica no tiene datos todavía, no se muestra.
const [
  { count: totalNegocios },
  { count: views },
  { count: whatsappClicks },
  { count: totalCategorias },
] = await Promise.all([
  supabase
    .from("businesses")
    .select("id", { count: "exact", head: true })
    .eq("barrio_id", barrio.id)
    .eq("is_active", true),
  countEvents("view"),
  countEvents("whatsapp"),
  supabase.from("categories").select("id", { count: "exact", head: true }),
]);

const stats: { value: string; label: string }[] = [
  {
    value: (totalNegocios ?? 0).toLocaleString("es-AR"),
    label: `Comercios de ${barrio.name} ya cargados`,
  },
];

if (views) {
  stats.push({
    value: views.toLocaleString("es-AR"),
    label: "Fichas vistas en los últimos 30 días",
  });
}

if (whatsappClicks) {
  stats.push({
    value: whatsappClicks.toLocaleString("es-AR"),
    label: "Contactos por WhatsApp en el último mes",
  });
}

if (stats.length < 3 && totalCategorias) {
  stats.push({
    value: String(totalCategorias),
    label: "Rubros donde puede aparecer tu negocio",
  });
}

stats.push({
  value: `$${price.toLocaleString("es-AR")}`,
  label: "Por mes el plan Destacado, sin permanencia",
});

const PASOS = [
  {
    icon: Store,
    titulo: "Cargá tu negocio gratis",
    texto:
      "Entrás con tu cuenta de Google, completás la ficha con fotos, horarios y WhatsApp. Lo hacés vos, en 5 minutos, sin esperar a nadie.",
  },
  {
    icon: BadgeCheck,
    titulo: "Lo revisamos y publicamos",
    texto: `Verificamos que sea un comercio real del barrio y tu ficha queda visible en la guía, el buscador y el mapa de ${barrio.name}.`,
  },
  {
    icon: Star,
    titulo: "Destacalo cuando quieras",
    texto:
      "Con un click activás el plan Destacado desde tu panel. Pagás con Mercado Pago y los beneficios se activan al instante.",
  },
];

const GRATIS = [
  "Ficha completa con foto, horarios y descripción",
  "Botón directo de WhatsApp y teléfono",
  `1 oferta activa en Ofertas de ${barrio.name}`,
  "Aparecés en la guía, el buscador y el mapa",
  `Link propio para compartir (${barrio.domain}/negocios/tu-negocio)`,
  "La editás vos mismo cuando quieras, desde el celular",
];

const DESTACADO = [
  "Primero en el listado de negocios",
  "En la portada del sitio, que ven todos los vecinos",
  "Galería de hasta 4 fotos en tu ficha",
  "Hasta 5 ofertas activas a la vez",
  "Estadísticas: vistas, contactos por WhatsApp y llamadas",
  "Lista de servicios y precios en tu ficha",
  "Insignia de destacado en tu card y en tu ficha",
  "Marcador dorado en el mapa del barrio",
  "Pago automático con Mercado Pago",
];

const sectionTitle =
  "text-[22px] font-extrabold tracking-[-0.02em] text-text-main sm:text-[28px]";
---

<Layout
  title={`Anunciá tu negocio en ${barrio.name}`}
  description={`Sumá tu comercio gratis al portal de ${barrio.name} y destacalo por $${price.toLocaleString("es-AR")}/mes. Ficha con WhatsApp, fotos, horarios y mapa. Sin permanencia.`}
>
  <div class="flex flex-col gap-11">
    <!-- HERO -->
    <section class="grid gap-8 lg:grid-cols-[1fr_400px] lg:items-center lg:gap-11">
      <div>
        <div
          class="mb-5 inline-flex items-center gap-2 rounded-full bg-primary-soft px-3 py-[7px] text-[12.5px] font-bold uppercase tracking-[0.08em] text-primary-strong"
        >
          <TrendingUp class="size-[14px]" aria-hidden="true" />
          Para comercios del barrio
        </div>

        <h1
          class="mb-4 text-[32px] font-extrabold leading-[1.03] tracking-[-0.028em] text-text-main sm:text-[56px]"
        >
          Que todo {barrio.name}<br />encuentre tu negocio.
        </h1>

        <p
          class="mb-6 max-w-[560px] text-[15.5px] leading-relaxed text-text-body sm:text-[17.5px]"
        >
          {(totalNegocios ?? 0).toLocaleString("es-AR")} comercios del barrio ya
          están en el portal. Tu ficha es <strong class="font-bold"
            >gratis para siempre</strong
          > — y si querés aparecer primero, la destacás por ${
            price.toLocaleString("es-AR")
          } al mes. Sin contrato ni permanencia.
        </p>

        <div class="flex flex-wrap gap-3">
          <a
            href="/app/negocios/nuevo"
            class="inline-flex items-center gap-2 rounded-[14px] bg-primary px-7 py-4 text-[15.5px] font-semibold text-white transition-colors hover:bg-primary-hover"
          >
            <Store class="size-[17px]" aria-hidden="true" />
            Cargar mi negocio gratis
          </a>
          <a
            href="#planes"
            class="inline-flex items-center rounded-[14px] bg-primary-faint px-[26px] py-4 text-[15.5px] font-semibold text-text-main transition-colors hover:bg-primary-soft"
          >
            Ver el plan Destacado
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        {
          stats.map((stat, i) => (
            <div
              class:list={[
                "rounded-[18px] bg-bg-card p-5 shadow-soft",
                // Con un número impar de métricas, la última ocupa la fila
                stats.length % 2 === 1 && i === stats.length - 1 && "col-span-2",
              ]}
            >
              <div class="text-[26px] font-extrabold leading-none tracking-[-0.025em] text-text-main sm:text-[32px]">
                {stat.value}
              </div>
              <div class="mt-1.5 text-[12.5px] leading-normal text-text-muted">
                {stat.label}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CÓMO FUNCIONA -->
    <section>
      <h2 class={`mb-5 ${sectionTitle}`}>Cómo funciona</h2>

      <div class="grid gap-4 lg:grid-cols-3">
        {
          PASOS.map((paso, i) => (
            <div class="rounded-[20px] bg-bg-card p-6 shadow-soft">
              <div class="mb-3 flex items-center gap-3">
                <span class="flex size-8 items-center justify-center rounded-full bg-primary-soft text-[14px] font-extrabold text-primary-strong">
                  {i + 1}
                </span>
                <paso.icon class="size-5 text-primary" aria-hidden="true" />
              </div>
              <div class="mb-[7px] text-[17px] font-bold text-text-main">
                {paso.titulo}
              </div>
              <p class="text-[13.5px] leading-relaxed text-text-body">
                {paso.texto}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- PLANES -->
    <section id="planes" class="scroll-mt-24">
      <h2 class={`mb-1.5 ${sectionTitle}`}>Simple: gratis, o destacado</h2>
      <p class="mb-6 text-[15px] text-text-body">
        Sin contratos, sin permanencia, sin letra chica.
      </p>

      <div class="grid gap-[18px] lg:grid-cols-[1fr_1.15fr]">
        <!-- GRATIS -->
        <div class="flex flex-col rounded-3xl bg-bg-card p-7 shadow-soft sm:p-[30px]">
          <div class="mb-1.5 text-[18px] font-bold text-text-main">
            Tu ficha en {barrio.name}
          </div>
          <div class="mb-5 flex items-baseline gap-2">
            <span
              class="text-[32px] font-extrabold tracking-[-0.025em] text-text-main sm:text-[38px]"
            >
              Gratis
            </span>
            <span class="text-[13.5px] text-text-muted">para siempre</span>
          </div>

          <div class="mb-6 flex flex-1 flex-col gap-2.5">
            {
              GRATIS.map((item) => (
                <div class="flex items-start gap-2.5 text-[14px] leading-normal text-text-body">
                  <Check
                    class="mt-0.5 size-4 shrink-0 text-primary"
                    aria-hidden="true"
                  />
                  {item}
                </div>
              ))
            }
          </div>

          <a
            href="/app/negocios/nuevo"
            class="block rounded-[13px] border-[1.5px] border-primary p-3.5 text-center text-[14.5px] font-semibold text-primary-strong transition-colors hover:bg-primary-soft"
          >
            Cargar mi negocio
          </a>
        </div>

        <!-- DESTACADO -->
        <div class="relative flex flex-col rounded-3xl bg-primary-deep p-7 text-white sm:p-[30px]">
          <span
            class="absolute right-6 top-6 rounded-full bg-rating px-3 py-1.5 text-[11px] font-extrabold uppercase tracking-[0.08em] text-[#3d2a00]"
          >
            Recomendado
          </span>

          <div class="mb-1.5 inline-flex items-center gap-2 text-[18px] font-bold">
            <Star class="size-[17px] fill-rating text-rating" aria-hidden="true" />
            Plan Destacado
          </div>
          <div class="mb-2 flex items-baseline gap-2">
            <span
              class="text-[36px] font-extrabold tracking-[-0.028em] sm:text-[44px]"
            >
              ${price.toLocaleString("es-AR")}
            </span>
            <span class="text-[14px] text-white/60">/ mes</span>
          </div>
          <p class="mb-5 text-[14px] text-white/72">
            Todo lo del plan gratuito, más:
          </p>

          <div class="mb-6 grid flex-1 content-start gap-x-[22px] gap-y-[11px] sm:grid-cols-2">
            {
              DESTACADO.map((item) => (
                <div class="flex items-start gap-2.5 text-[13.5px] leading-normal text-white/88">
                  <Check
                    class="mt-0.5 size-[15px] shrink-0 text-rating"
                    aria-hidden="true"
                  />
                  {item}
                </div>
              ))
            }
          </div>

          <a
            href="/app"
            class="flex items-center justify-center gap-2.5 rounded-[13px] bg-primary p-[15px] text-[15px] font-semibold text-white transition-colors hover:bg-primary-hover"
          >
            Destacar mi negocio
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
          <p class="mt-3.5 text-center text-[12.5px] text-white/55">
            Pago con Mercado Pago · se activa al instante · cancelás cuando
            quieras
          </p>
        </div>
      </div>
    </section>

    <!-- ÁNGULO COMUNITARIO -->
    <section>
      <div
        class="rounded-[22px] border border-[rgba(14,159,82,.22)] bg-[#f2fbf5] p-7 text-center sm:p-8"
      >
        <HeartHandshake
          class="mx-auto size-[26px] text-primary-strong"
          aria-hidden="true"
        />
        <h2
          class="mb-2.5 mt-3 text-[20px] font-extrabold tracking-[-0.015em] text-text-main sm:text-[24px]"
        >
          Al destacarte, sostenés el portal del barrio
        </h2>
        <p
          class="mx-auto mb-[18px] max-w-[660px] text-[14.5px] leading-relaxed text-text-body"
        >
          {barrio.name} es un proyecto independiente hecho por y para los vecinos:
          la guía de comercios, las farmacias de turno y los teléfonos útiles son
          gratuitos para toda la comunidad. Los planes Destacado son lo que lo mantiene
          andando.
        </p>
        <a
          href="/app/negocios/nuevo"
          class="inline-block rounded-[14px] bg-primary px-7 py-[15px] text-[15px] font-semibold text-white transition-colors hover:bg-primary-hover"
        >
          Empezar ahora — es gratis
        </a>
      </div>
    </section>
  </div>
</Layout>
