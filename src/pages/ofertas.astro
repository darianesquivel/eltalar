---
import { Flame, ChevronDown } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import OfferCard from "../components/ofertas/OfferCard.astro";
import { getActiveOffers } from "../lib/repositories/offer.repository";

const { barrio } = Astro.locals;

const rubro = Astro.url.searchParams.get("rubro");
const orden = Astro.url.searchParams.get("orden") === "nuevas" ? "nuevas" : "vencen";

// Todas las ofertas vigentes del barrio: son pocas (decenas), así que el
// filtro por rubro y el orden se resuelven acá, sin JavaScript en el cliente.
const { offers: allOffers } = await getActiveOffers(barrio.id);

const countsBySlug = new Map<string, { name: string; count: number }>();
for (const offer of allOffers) {
  for (const category of offer.business.categories) {
    const entry = countsBySlug.get(category.slug);
    if (entry) entry.count += 1;
    else countsBySlug.set(category.slug, { name: category.name, count: 1 });
  }
}
const categoryChips = [...countsBySlug.entries()]
  .map(([slug, { name, count }]) => ({ slug, name, count }))
  .sort((a, b) => b.count - a.count);

const filtered = rubro
  ? allOffers.filter((o) => o.business.categories.some((c) => c.slug === rubro))
  : allOffers;

const offers =
  orden === "nuevas"
    ? [...filtered].sort((a, b) => b.created_at.localeCompare(a.created_at))
    : filtered;

const chipClass = (active: boolean) =>
  `rounded-full px-4 py-[9px] text-[13.5px] transition-colors ${
    active
      ? "bg-secondary font-semibold text-white"
      : "border border-border bg-bg-card font-medium text-text-main hover:border-[rgba(14,26,18,.2)]"
  }`;

const hrefWith = (params: Record<string, string | null>) => {
  const url = new URL(Astro.url);
  for (const [key, value] of Object.entries(params)) {
    if (value) url.searchParams.set(key, value);
    else url.searchParams.delete(key);
  }
  return `${url.pathname}${url.search}`;
};
---

<Layout
  title={`Ofertas en ${barrio.name}`}
  description={`Promos y ofertas vigentes de los comercios de ${barrio.name}: descuentos, 2x1 y más, publicadas por los propios negocios del barrio.`}
>
  <div class="flex flex-col gap-6">
    <header>
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full bg-offer-soft px-3 py-[7px] text-[12.5px] font-bold uppercase tracking-[0.08em] text-offer"
      >
        <Flame class="size-[14px]" aria-hidden="true" />
        {`${allOffers.length} ${allOffers.length === 1 ? "oferta vigente" : "ofertas vigentes"}`}
      </div>

      <h1
        class="mb-2 text-[29px] font-extrabold leading-[1.05] tracking-[-0.025em] text-text-main sm:text-[44px]"
      >
        Ofertas de los comercios del barrio
      </h1>
      <p class="max-w-[640px] text-[15px] text-text-body sm:text-[16px]">
        Las publican los propios negocios y se vencen solas. Si ves una acá,
        está vigente hoy.
      </p>
    </header>

    {
      allOffers.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 border-b border-border pb-6">
          <a href={hrefWith({ rubro: null })} class={chipClass(!rubro)}>
            Todas{" "}
            <span class={!rubro ? "text-white/55" : "text-text-faint"}>
              {allOffers.length}
            </span>
          </a>

          {categoryChips.map((category) => {
            const active = rubro === category.slug;
            return (
              <a
                href={hrefWith({ rubro: active ? null : category.slug })}
                class={chipClass(active)}
              >
                {category.name}{" "}
                <span class={active ? "text-white/55" : "text-text-faint"}>
                  {category.count}
                </span>
              </a>
            );
          })}

          <a
            href={hrefWith({ orden: orden === "vencen" ? "nuevas" : null })}
            class="ml-auto inline-flex items-center gap-2 rounded-xl border border-border bg-bg-card px-3.5 py-[9px] text-[13px] font-semibold text-text-main"
          >
            {orden === "vencen" ? "Vencen primero" : "Más nuevas"}
            <ChevronDown class="size-[14px]" aria-hidden="true" />
          </a>
        </div>
      )
    }

    {
      offers.length > 0 ? (
        <div class="grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3">
          {offers.map((offer) => (
            <OfferCard offer={offer} barrioName={barrio.name} />
          ))}
        </div>
      ) : (
        <div class="rounded-[20px] bg-bg-card p-10 text-center shadow-soft">
          <h2 class="mb-2 text-[19px] font-extrabold text-text-main">
            {rubro
              ? "No hay ofertas vigentes en ese rubro"
              : "No hay ofertas vigentes en este momento"}
          </h2>
          <p class="mx-auto mb-5 max-w-md text-[14px] text-text-body">
            Los comercios del barrio publican sus promos acá y se vencen solas.
            Volvé pronto — o si tenés un negocio, publicá la tuya.
          </p>
          <a
            href="/anunciate"
            class="inline-block rounded-[14px] bg-primary px-6 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-primary-hover"
          >
            Publicar mi negocio
          </a>
        </div>
      )
    }

    {
      offers.length > 0 && (
        <div class="flex flex-col gap-6 rounded-[20px] bg-bg-card p-7 shadow-soft sm:flex-row sm:items-center sm:justify-between sm:px-8">
          <div>
            <div class="mb-1.5 text-[19px] font-extrabold tracking-[-0.015em] text-text-main sm:text-[22px]">
              ¿Tenés un comercio? Publicá tu promo gratis
            </div>
            <p class="text-[14.5px] text-text-body">
              Las ofertas las cargás desde el panel de tu negocio y se vencen
              solas en la fecha que elijas.
            </p>
          </div>
          <a
            href="/app"
            class="shrink-0 rounded-[14px] bg-primary px-[26px] py-[15px] text-center text-[15px] font-semibold text-white transition-colors hover:bg-primary-hover"
          >
            Publicar una oferta
          </a>
        </div>
      )
    }
  </div>
</Layout>
