---
import { ArrowLeft, ShieldCheck } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import ClassifiedForm from "../../components/avisos/ClassifiedForm";
import { createSupabaseServer } from "../../lib/supabase/server";

const { barrio } = Astro.locals;

// El middleware solo resuelve la sesión dentro de /app: esta página es
// pública pero necesita saber quién es el vecino, así que la consulta acá.
const {
  data: { user },
} = await createSupabaseServer(Astro).auth.getUser();

// Publicar exige cuenta: un aviso sin dueño no se puede atribuir ni
// bloquear si es spam. El nombre de Google viene precargado y se puede
// cambiar (el vecino elige cómo lo llaman).
const metadata = (user?.user_metadata ?? {}) as Record<string, string>;
const defaultName =
  metadata.full_name || metadata.name || user?.email?.split("@")[0] || "";
---

<Layout
  title={`Publicar un aviso en ${barrio.name}`}
  description={`Publicá gratis tu aviso de compra, venta, servicio o pedido para los vecinos de ${barrio.name}.`}
>
  <div class="mx-auto flex w-full max-w-[680px] flex-col gap-5">
    <a
      href="/avisos"
      class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-primary-strong"
    >
      <ArrowLeft class="size-[15px]" aria-hidden="true" />
      Volver a los avisos
    </a>

    <header>
      <h1
        class="mb-2 text-[27px] font-extrabold leading-[1.05] tracking-[-0.025em] text-text-main sm:text-[36px]"
      >
        Publicar un aviso
      </h1>
      <p class="text-[15px] text-text-body">
        Gratis, para vecinos de {barrio.name}. Si tenés un comercio, cargalo en
        la <a href="/anunciate" class="font-semibold text-primary-strong">
          guía de negocios
        </a> — también es gratis y se ve mejor.
      </p>
    </header>

    {
      user ? (
        <ClassifiedForm defaultName={defaultName} client:load />
      ) : (
        <div class="rounded-[20px] bg-bg-card p-7 shadow-soft sm:p-8">
          <div class="mb-3 flex size-11 items-center justify-center rounded-xl bg-primary-soft text-primary-strong">
            <ShieldCheck class="size-5" aria-hidden="true" />
          </div>
          <h2 class="mb-2 text-[19px] font-extrabold text-text-main">
            Entrá con tu cuenta para publicar
          </h2>
          <p class="mb-5 text-[14.5px] leading-relaxed text-text-body">
            Es un click con Google. Pedimos la cuenta para que cada aviso tenga
            un responsable: así podemos frenar el spam y vos podés editar o
            borrar el tuyo cuando quieras.
          </p>
          <a
            href="/app/login?next=/avisos/nuevo"
            class="inline-block rounded-[14px] bg-primary px-6 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-primary-hover"
          >
            Entrar con Google
          </a>
        </div>
      )
    }
  </div>
</Layout>
