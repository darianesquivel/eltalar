---
import { ArrowLeft, Plus } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import MyClassifieds from "../../components/avisos/MyClassifieds";
import { createSupabaseServer } from "../../lib/supabase/server";

const { barrio } = Astro.locals;

// El middleware solo resuelve la sesión dentro de /app: acá se consulta.
// El cliente de sesión respeta la RLS, así que solo trae los avisos propios.
const supabase = createSupabaseServer(Astro);
const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/app/login?next=/avisos/mios");
}

const { data: classifieds } = await supabase
  .from("classifieds")
  .select(
    "id, category, title, price_text, photo_url, status, published_at, expires_at, created_at",
  )
  .eq("owner_id", user.id)
  .order("created_at", { ascending: false });
---

<Layout
  title={`Mis avisos | ${barrio.name}`}
  description="Editá o borrá los avisos que publicaste en el barrio."
>
  <div class="mx-auto flex w-full max-w-[820px] flex-col gap-5">
    <a
      href="/avisos"
      class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-primary-strong"
    >
      <ArrowLeft class="size-[15px]" aria-hidden="true" />
      Volver a los avisos
    </a>

    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1
          class="mb-2 text-[27px] font-extrabold leading-[1.05] tracking-[-0.025em] text-text-main sm:text-[36px]"
        >
          Mis avisos
        </h1>
        <p class="text-[15px] text-text-body">
          Renovar estira 30 días más sin pasar por revisión. Editar sí vuelve
          a revisarse. Los avisos vencidos se borran solos a la semana.
        </p>
      </div>

      <a
        href="/avisos/nuevo"
        class="inline-flex shrink-0 items-center gap-2 rounded-[13px] bg-secondary px-5 py-3 text-[14px] font-semibold text-white"
      >
        <Plus class="size-4" aria-hidden="true" />
        Publicar otro
      </a>
    </header>

    <MyClassifieds classifieds={classifieds ?? []} client:load />
  </div>
</Layout>
