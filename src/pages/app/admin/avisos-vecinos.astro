---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ClassifiedsManager from "../../../components/app/ClassifiedsManager";
import { createSupabaseServer } from "../../../lib/supabase/server";
import { getAdminBarrio } from "../../../lib/barrio";

const supabase = createSupabaseServer(Astro);
const barrio = await getAdminBarrio(Astro);

const SELECT =
  "id, category, title, description, price_text, whatsapp, author_name, photo_url, status, created_at, expires_at";

const [{ data: pending }, { data: published }, { data: rejected }] =
  await Promise.all([
    supabase
      .from("classifieds")
      .select(SELECT)
      .eq("barrio_id", barrio.id)
      .eq("status", "pending")
      .order("created_at"),
    supabase
      .from("classifieds")
      .select(SELECT)
      .eq("barrio_id", barrio.id)
      .eq("status", "published")
      .order("published_at", { ascending: false })
      .limit(100),
    // Los rechazados se ven una semana (después los borra el cron): da
    // margen para deshacer un rechazo por error
    supabase
      .from("classifieds")
      .select(SELECT)
      .eq("barrio_id", barrio.id)
      .eq("status", "rejected")
      .order("created_at", { ascending: false })
      .limit(100),
  ]);
---

<AdminLayout title="Avisos de vecinos">
  <div class="mx-auto max-w-4xl space-y-6">
    <div>
      <h1 class="text-2xl font-bold">Avisos de vecinos</h1>
      <p class="text-sm text-gray-500">
        Los clasificados que publican los vecinos. Revisá que sean del barrio y
        que no sean comercios encubiertos, armas, medicamentos ni reventa de
        entradas. Al publicar, el aviso queda visible 30 días; podés bajarlo o
        borrarlo en cualquier momento.
      </p>
    </div>

    <ClassifiedsManager
      pending={pending ?? []}
      published={published ?? []}
      rejected={rejected ?? []}
      client:load
    />
  </div>
</AdminLayout>
