---
import Layout from "../../layouts/Layout.astro";
import CategoryFilter from "../../components/negocios/CategoryFilter.client";
import BusinessGrid from "../../components/negocios/BusinessGrid.client";
import {
  getBusinessesPage,
  getCategoryCounts,
  hasRatings,
  parseBusinessOrder,
} from "../../lib/repositories/business.repository";
import { supabase } from "../../lib/supabase";

const PAGE_SIZE = 24;

// El listado se pagina en la base: acá viaja solo la PRIMERA tanda (SEO y
// primer paint); el resto lo pide BusinessGrid a /api/negocios al scrollear.
// Los filtros de la URL se respetan en el servidor para que una URL
// compartida (ej. ?categoria=gastronomia) cargue ya filtrada.
const categoria = Astro.url.searchParams.get("categoria");
const buscar = Astro.url.searchParams.get("buscar");
const orden = parseBusinessOrder(Astro.url.searchParams.get("orden"));
const minRating = Number(Astro.url.searchParams.get("min_rating")) || null;
const soloOfertas = Astro.url.searchParams.get("ofertas") === "1";
const abiertoAhora = Astro.url.searchParams.get("abierto") === "1";

const barrio = Astro.locals.barrio;

const [page, { data: categories }, ratingsEnabled] = await Promise.all([
  getBusinessesPage({
    barrioId: barrio.id,
    limit: PAGE_SIZE,
    categorySlug: categoria,
    search: buscar,
    order: orden,
    minRating,
    onlyOffers: soloOfertas,
    openNow: abiertoAhora,
  }),
  supabase.from("categories").select("id, name, slug, icon").order("name"),
  hasRatings(barrio.id),
]);

// Los chips de rubro llevan el contador de negocios activos (cacheado 5 min)
const counts = await getCategoryCounts(
  barrio.id,
  (categories ?? []).map((c) => c.slug),
);

// Sin negocios cargados un rubro no ayuda a nadie: se esconde
const categoriesWithCount = (categories ?? [])
  .map((c) => ({ ...c, count: counts.bySlug[c.slug] ?? 0 }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);
---

<Layout
  title={`Negocios y Servicios en ${barrio.name}`}
  description={`Guía de comercios y servicios de ${barrio.name}: horarios, teléfonos, WhatsApp y ubicación de los negocios del barrio.`}
>
  <div class="flex flex-col gap-[22px]">
    <header class="flex flex-col gap-2">
      <h1
        class="text-[29px] font-extrabold leading-[1.05] tracking-[-0.025em] text-text-main sm:text-[44px]"
      >
        Negocios de {barrio.name}
      </h1>
      <p class="max-w-[560px] text-[15px] leading-relaxed text-text-body sm:text-[17px]">
        Comercios, servicios y profesionales del barrio. Contactalos directo por
        WhatsApp.
      </p>
    </header>

    <CategoryFilter
      categories={categoriesWithCount}
      total={counts.total}
      ratingsEnabled={ratingsEnabled}
      client:load
    />

    <BusinessGrid
      initialItems={page.items}
      initialTotal={page.total}
      initialCategory={categoria}
      initialSearch={buscar}
      initialOrder={orden}
      initialMinRating={minRating}
      initialOffers={soloOfertas}
      initialOpenNow={abiertoAhora}
      pageSize={PAGE_SIZE}
      client:load
    />
  </div>
</Layout>
