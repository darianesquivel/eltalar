---
import Layout from "../../layouts/Layout.astro";
import BusinessDetail from "../../components/negocios/BusinessDetail.astro";
import { getBusinessBySlug } from "../../lib/repositories/business.repository";
import { instagramUrl } from "../../lib/links";

const { slug } = Astro.params;
const { barrio } = Astro.locals;

const business = slug ? await getBusinessBySlug(slug, barrio.id) : null;

// Rewrite (no redirect): devuelve la página 404 con status 404 real,
// que es lo que los buscadores esperan para un negocio inexistente.
if (!business) {
  return Astro.rewrite("/404");
}

// Cortada en palabra y con puntos suspensivos: el .slice() seco partía
// una palabra al medio en el resultado de Google.
const truncate = (text: string, max: number) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max - 1);
  return `${cut.slice(0, Math.max(cut.lastIndexOf(" "), max - 20))}…`;
};

const description = business.description?.trim()
  ? truncate(business.description.trim(), 160)
  : `${business.name} en ${barrio.name}: horarios, teléfono, WhatsApp y ubicación.`;

// Datos estructurados schema.org: le dicen a Google que esto es un negocio
// local con dirección y horarios (mejora el SEO local y los rich results).
const SCHEMA_DAYS = [
  "Sunday",
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
];

// Con turno no hay horarios fijos: no exponerlos en el SEO
const openingHours = (
  business.by_appointment ? [] : (business.business_hours ?? [])
)
  .filter(
    (h) => !h.is_closed && (h.is_open_24 || (h.open_time && h.close_time)),
  )
  .map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: SCHEMA_DAYS[h.day_of_week],
    opens: h.is_open_24 ? "00:00" : h.open_time!.slice(0, 5),
    closes: h.is_open_24 ? "23:59" : h.close_time!.slice(0, 5),
  }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: business.name,
  description,
  url: new URL(`/negocios/${business.slug}`, barrio.url).toString(),
  ...(business.coverPhoto?.url && { image: business.coverPhoto.url }),
  ...(business.phone && { telephone: business.phone }),
  ...(business.address && {
    address: {
      "@type": "PostalAddress",
      streetAddress: business.address,
      addressLocality: barrio.name,
      addressRegion: "Buenos Aires",
      addressCountry: "AR",
    },
  }),
  ...(business.lat != null &&
    business.lng != null && {
      geo: {
        "@type": "GeoCoordinates",
        latitude: business.lat,
        longitude: business.lng,
      },
    }),
  ...(business.instagram && { sameAs: [instagramUrl(business.instagram)] }),
  ...(openingHours.length > 0 && { openingHoursSpecification: openingHours }),
  // Rich result de estrellas en Google: gratis, los datos ya están
  ...(business.rating_count > 0 &&
    business.rating_avg != null && {
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: business.rating_avg,
        reviewCount: business.rating_count,
        bestRating: 5,
        worstRating: 1,
      },
    }),
};
---

<Layout
  title={`${business.name} | ${barrio.name}`}
  description={description}
  image={business.coverPhoto?.url}
  hideTabBar
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <BusinessDetail business={business} />
</Layout>
