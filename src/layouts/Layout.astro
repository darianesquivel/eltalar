---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import MobileTabBar from "../components/header/MobileTabBar.astro";
import NavLoader from "../components/NavLoader.astro";
import { ClientRouter } from "astro:transitions";
import { DEFAULT_BARRIO } from "../lib/barrio";
import heroBg from "../images/hero-bg.jpg";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** URL absoluta de imagen para compartir en redes (og:image). */
  image?: string;
  /**
   * `true` = la página maneja su propio ancho y padding (bandas a sangre,
   * como la home rediseñada). Por defecto el `<main>` centra el contenido
   * a 1200 px con el padding del sistema (40 px desktop / 18 px mobile).
   */
  wide?: boolean;
  /**
   * `true` en las páginas que tienen su propia barra de acción fija en
   * mobile (la ficha de negocio): dos barras fijas no pueden convivir.
   */
  hideTabBar?: boolean;
}

// El fallback cubre las páginas prerenderizadas (404), donde no hay request
const barrio = Astro.locals.barrio ?? DEFAULT_BARRIO;

const {
  title = `${barrio.name} — Guía del barrio`,
  description = `Guía de ${barrio.name}, ${barrio.partido}: negocios y servicios del barrio, farmacias de turno y teléfonos útiles, todo en un solo lugar.`,
  image,
  wide = false,
  hideTabBar = false,
} = Astro.props;

// El colchón de 92 px que deja libre la tab bar mobile lo pone el footer.
const mainClass = wide
  ? "flex flex-1 flex-col"
  : "mx-auto flex w-full max-w-[1200px] flex-1 flex-col gap-12 px-[18px] py-6 sm:px-10 sm:py-10";

// Canónica sobre el dominio del barrio (un deploy sirve varios dominios).
// Los filtros indexables (rubro de la guía / de avisos y ofertas) se
// conservan: son las landing de SEO local. Antes se recortaba TODO el query
// string y las páginas filtradas le decían a Google que se descartaran.
const canonical = new URL(Astro.url.pathname, barrio.url);
for (const param of ["categoria", "rubro"]) {
  const value = Astro.url.searchParams.get(param);
  if (value) canonical.searchParams.set(param, value);
}

// Fallback para compartir en WhatsApp/redes: sin og:image, la home y los
// listados se compartían sin preview.
const ogImage = image ?? new URL(heroBg.src, barrio.url).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- El sitio es claro y punto. Sin esto, Chrome en Android y Samsung
         Internet "auto-oscurecen" las páginas que no declaran su esquema
         cuando el teléfono está en modo oscuro, y se veía la primera
         pantalla en negro. theme-color pinta la barra del navegador del
         mismo color que el fondo del sitio. -->
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fbfaf6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Los dos pesos que se ven arriba del pliegue en todas las páginas
         (cuerpo y títulos): precargarlos evita el flash de fuente. -->
    <link
      rel="preload"
      href="/fonts/StackSansText-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/StackSansText-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (WhatsApp, Facebook, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={barrio.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />
  </head>

  <body class="flex min-h-screen flex-col bg-bg-main text-text-main">
    <NavLoader />
    <Header />
    <main class={mainClass}>
      <slot />
    </main>
    <Footer />
    {!hideTabBar && <MobileTabBar />}
  </body>
</html>
