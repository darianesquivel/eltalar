---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import MobileTabBar from "../components/header/MobileTabBar.astro";
import NavLoader from "../components/NavLoader.astro";
import { ClientRouter } from "astro:transitions";
import { DEFAULT_BARRIO } from "../lib/barrio";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** URL absoluta de imagen para compartir en redes (og:image). */
  image?: string;
  /**
   * `true` = la página maneja su propio ancho y padding (bandas a sangre,
   * como la home rediseñada). Por defecto el `<main>` centra el contenido
   * a 1200 px con el padding del sistema (40 px desktop / 18 px mobile).
   */
  wide?: boolean;
}

// El fallback cubre las páginas prerenderizadas (404), donde no hay request
const barrio = Astro.locals.barrio ?? DEFAULT_BARRIO;

const {
  title = `${barrio.name} — Guía del barrio`,
  description = `Guía de ${barrio.name}, ${barrio.partido}: negocios y servicios del barrio, farmacias de turno y teléfonos útiles, todo en un solo lugar.`,
  image,
  wide = false,
} = Astro.props;

// El colchón de 92 px que deja libre la tab bar mobile lo pone el footer.
const mainClass = wide
  ? "flex flex-1 flex-col"
  : "mx-auto flex w-full max-w-[1200px] flex-1 flex-col gap-12 px-[18px] py-6 sm:px-10 sm:py-10";

// Canónica sobre el dominio del barrio (un deploy sirve varios dominios)
const canonical = new URL(Astro.url.pathname, barrio.url);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (WhatsApp, Facebook, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={barrio.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}

    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />

    <ClientRouter />
  </head>

  <body class="flex min-h-screen flex-col bg-bg-main text-text-main">
    <NavLoader />
    <Header />
    <main class={mainClass}>
      <slot />
    </main>
    <Footer />
    <MobileTabBar />
  </body>
</html>
